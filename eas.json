{
  "cli": {
    "version": ">= 16.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "store",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease",
        "env": {
          "EXPO_USE_HERMES": "true"
        }
      },
      "ios": {
        "env": {
          "EXPO_USE_HERMES": "true"
        }
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
