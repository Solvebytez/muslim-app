{
  "expo": {
    "name": "Muslim Compass",
    "slug": "muslim-guide",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "muslimguide",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sahin05.muslimguide",
      "buildNumber": "20",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to show prayer times and nearby mosques.",
        "NSLocationAlwaysUsageDescription": "Your location helps us provide accurate guidance features at all times.",
        "UIBackgroundModes": [
          "processing",
          "fetch",
          "remote-notification"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.sahin05.muslimguide.background-notification-task"
        ],
        "NSUserNotificationsUsageDescription": "We need notification permission to remind you of prayer times with azan.",
        "NSCameraUsageDescription": "We need camera access to take photos of hotels and restaurants.",
        "NSPhotoLibraryUsageDescription": "We need photo library access to select images for hotels and restaurants.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 40,
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sahin05.muslimguide",
      "edgeToEdgeEnabled": false,
      "largeHeap": true,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.facebook.hermes.unicode.** { *; }",
            "packagingOptions": {
              "jniLibs": {
                "useLegacyPackaging": false
              }
            }
          }
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/azan.mp3"
          ],
          "icon": "./assets/images/notification-icon.png",
          "color": "#4A5FBF",
          "androidMode": "default",
          "androidCollapsedTitle": "Prayer Time",
          "iosDisplayInForeground": true,
          "requestPermissionsImmediately": false,
          "enableBackgroundRefresh": true,
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-image-picker",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1080606585301-eep2fi6uk8e50r953cd2ajfl2ngh9jd4"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow this app to use your location for prayer times and guidance."
        }
      ],
      [
        "expo-task-manager",
        {
          "backgroundModes": [
            "background-processing",
            "background-fetch"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "APP_API_TOKEN": "asf2e9996686b942552d8457f58888de149fcd4f763dfce5ce5e0bfdcfe4ddb1adca35e775sdfc434c682d",
      "EXPO_PUBLIC_BASE_URL": "https://api.muslimcompass.io",
      "GOOGLE_PLACES_API_KEY": "AIzaSyClXvtoj2ZPPeLW0r5-6_a0e6xKvjh2pIU",
      "EXPO_GOOGLE_IOS_CLIENT_ID": "1080606585301-eep2fi6uk8e50r953cd2ajfl2ngh9jd4.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "a973b7e8-3887-4e01-bbfb-c88c8c950e7c"
      }
    }
  }
}
